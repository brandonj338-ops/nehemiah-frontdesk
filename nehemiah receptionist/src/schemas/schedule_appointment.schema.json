{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "schedule_appointment",
  "description": "Book an appointment on the calendar + send confirmations. POST /api/appointment",
  "type": "object",
  "required": ["startISO", "endISO", "purpose"],
  "properties": {
    "name": { "type": "string" },
    "email": { "type": "string" },
    "phone": { "type": "string" },
    "purpose": { "type": "string", "description": "e.g. Intake appointment, Donor meeting, Volunteer onboarding" },
    "startISO": { "type": "string", "description": "ISO 8601 start, e.g. 2026-06-02T14:00:00-04:00" },
    "endISO": { "type": "string", "description": "ISO 8601 end" },
    "notes": { "type": "string" }
  }
}
